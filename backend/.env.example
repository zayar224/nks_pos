# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_strong_db_password
DB_NAME=testkernexpos
DB_CONNECTION_LIMIT=10

# Server
PORT=5200
NODE_ENV=development

# CORS - comma-separated list or single origin
APP_ORIGIN=http://localhost:5277

# JWT - generate a strong key: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_key

# HTTPS (optional - provide paths to cert and key files for production)
# HTTPS_KEY=/path/to/privkey.pem
# HTTPS_CERT=/path/to/cert.pem
